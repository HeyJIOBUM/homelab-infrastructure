services:
  garage:
    image: "dxflrs/garage:{{ garage_image_tag }}"
    container_name: garage
    restart: unless-stopped

    ports:
      - "{{ garage_s3_port }}:{{ garage_s3_port }}"
      - "{{ garage_rpc_port }}:{{ garage_rpc_port }}"
      - "{{ garage_web_port }}:{{ garage_web_port }}"
      - "{{ garage_admin_port }}:{{ garage_admin_port }}"

    volumes:
      - "{{ garage_config_dir }}/garage.toml:/etc/garage.toml:ro"
      - "{{ garage_admin_token_file }}:/etc/garage/admin.token:ro"
      - "{{ garage_rpc_secret_file }}:/etc/garage/rpc.secret:ro"
      - "{{ garage_meta_dir }}:/var/lib/garage/meta"
      - "{{ garage_data_dir }}:/var/lib/garage/data"

    networks:
      - {{ traefik_docker_network }}

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.garage-s3.rule=Host(`garage-s3.homelab`)"
      - "traefik.http.routers.garage-s3.entrypoints=websecure"
      - "traefik.http.routers.garage-s3.tls.certresolver=stepca"
      - "traefik.http.routers.garage-s3.service=garage-s3"
      - "traefik.http.services.garage-s3.loadbalancer.server.port={{ garage_s3_port }}"

      - "traefik.http.routers.garage-web.rule=Host(`garage-web.homelab`)"
      - "traefik.http.routers.garage-web.entrypoints=websecure"
      - "traefik.http.routers.garage-web.tls.certresolver=stepca"
      - "traefik.http.routers.garage-web.service=garage-web"
      - "traefik.http.services.garage-web.loadbalancer.server.port={{ garage_web_port }}"

      - "traefik.http.routers.garage-admin.rule=Host(`garage-admin.homelab`)"
      - "traefik.http.routers.garage-admin.entrypoints=websecure"
      - "traefik.http.routers.garage-admin.tls.certresolver=stepca"
      - "traefik.http.routers.garage-admin.service=garage-admin"
      - "traefik.http.services.garage-admin.loadbalancer.server.port={{ garage_admin_port }}"

  garage-ui:
    image: "noooste/garage-ui:{{ garage_ui_image_tag }}"
    container_name: garage-ui
    restart: unless-stopped
    depends_on:
      - garage

    ports:
      - "{{ garage_ui_port }}:{{ garage_ui_internal_port }}"

    volumes:
      - "{{ garage_config_dir }}/config.yaml:/app/config.yaml:ro"

    environment:
      GARAGE_UI_GARAGE_ADMIN_TOKEN: "{{ garage_admin_token }}"

    networks:
      - {{ traefik_docker_network }}

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.garage-ui.rule=Host(`garage-ui.homelab`)"
      - "traefik.http.routers.garage-ui.entrypoints=websecure"
      - "traefik.http.routers.garage-ui.tls.certresolver=stepca"
      - "traefik.http.services.garage-ui.loadbalancer.server.port={{ garage_ui_internal_port }}"

networks:
  {{ traefik_docker_network }}:
    external: true