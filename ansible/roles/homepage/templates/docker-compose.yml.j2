services:
  homepage:
    image: ghcr.io/gethomepage/homepage:{{ homepage_tag }}
    container_name: homepage
    restart: unless-stopped
    environment:
      - HOMEPAGE_ALLOWED_HOSTS=homepage.{{ technitium_dns_zone }}
    volumes:
      - {{ homepage_config_dir }}:/app/config
      - {{ homepage_icons_dir }}:/app/public/icons
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - {{ traefik_docker_network }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.homepage.rule=Host(`homepage.{{ technitium_dns_zone }}`)"
      - "traefik.http.routers.homepage.entrypoints=websecure"
      - "traefik.http.routers.homepage.tls.certresolver=stepca"
      - "traefik.http.services.homepage.loadbalancer.server.port={{ homepage_internal_port }}"
      - "homepage.group=Infrastructure"
      - "homepage.name=Homepage"
      - "homepage.icon=homepage.png"
      - "homepage.href=https://homepage.{{ technitium_dns_zone }}"
      - "homepage.description=Dashboard"

networks:
  {{ traefik_docker_network }}:
    external: true