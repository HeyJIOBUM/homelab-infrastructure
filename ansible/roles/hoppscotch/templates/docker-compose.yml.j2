services:
  hoppscotch-postgres:
    image: "postgres:16-alpine"
    container_name: hoppscotch-postgres
    restart: unless-stopped

    environment:
      POSTGRES_USER: hoppscotch
      POSTGRES_PASSWORD: "{{ hoppscotch_db_password }}"
      POSTGRES_DB: hoppscotch

    volumes:
      - "{{ hoppscotch_data_dir }}/postgres:/var/lib/postgresql/data"

    networks:
      - {{ traefik_docker_network }}

  hoppscotch:
    image: "hoppscotch/hoppscotch:{{ hoppscotch_tag }}"
    container_name: hoppscotch
    restart: unless-stopped

    depends_on:
      - hoppscotch-postgres

    environment:
      #-----------------------Backend Config------------------------------#

      # Prisma Config
      DATABASE_URL: "postgresql://hoppscotch:{{ hoppscotch_db_password }}@hoppscotch-postgres:5432/hoppscotch"

      # Sensitive Data Encryption Key while storing in Database (32 characters)
      DATA_ENCRYPTION_KEY: "{{ hoppscotch_data_encryption_key }}"

      # Whitelisted origins for the Hoppscotch App.
      # This list controls which origins can interact with the app through cross-origin comms.
      WHITELISTED_ORIGINS: >-
        http://app.hoppscotch_homelab,
        https://hoppscotch.homelab,
        app://hoppscotch_homelab

      #-----------------------Frontend Config------------------------------#

      # Base URLs
      VITE_BASE_URL: "https://hoppscotch.{{ technitium_dns_zone }}"
      VITE_SHORTCODE_BASE_URL: "https://hoppscotch.{{ technitium_dns_zone }}"
      VITE_ADMIN_URL: "https://hoppscotch.{{ technitium_dns_zone }}/admin"

      # Backend URLs
      VITE_BACKEND_GQL_URL: "https://hoppscotch.{{ technitium_dns_zone }}/backend/graphql"
      VITE_BACKEND_WS_URL: "wss://hoppscotch.{{ technitium_dns_zone }}/backend/graphql"
      VITE_BACKEND_API_URL: "https://hoppscotch.{{ technitium_dns_zone }}/backend/v1"

      # Set to `true` for subpath based access
      ENABLE_SUBPATH_BASED_ACCESS: "true"

      #-----------------------Container Runtime Config---------------------#

      # (Optional) Caddy's in-container HTTP port. Defaults to 80 when unset.
      # Set a free port (for example 8000) to run the container under a non-root UID.
      # HOPP_ALTERNATE_PORT=8000

    networks:
      - {{ traefik_docker_network }}

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.hoppscotch.rule=Host(`hoppscotch.{{ technitium_dns_zone }}`)"
      - "traefik.http.routers.hoppscotch.entrypoints=websecure"
      - "traefik.http.routers.hoppscotch.tls.certresolver=stepca"
      - "traefik.http.services.hoppscotch.loadbalancer.server.port=80"

      - "homepage.group=Infrastructure"
      - "homepage.name=Hoppscotch"
      - "homepage.description=Hoppscotch"
      - "homepage.icon=hoppscotch.png"
      - "homepage.href=https://hoppscotch.{{ technitium_dns_zone }}"

networks:
  {{ traefik_docker_network }}:
    external: true