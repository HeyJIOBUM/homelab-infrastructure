services:
  ittools:
    container_name: ittools
    image: corentinth/it-tools:{{ ittools_tag }}
    ports:
      - "{{ ittools_port }}:80"
    restart: unless-stopped
    networks:
      - {{ traefik_docker_network }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.ittools.rule=Host(`ittools.homelab`)"
      - "traefik.http.routers.ittools.entrypoints=websecure"
      - "traefik.http.routers.ittools.tls.certresolver=stepca"
      - "traefik.http.services.ittools.loadbalancer.server.port=80"

networks:
  {{ traefik_docker_network }}:
    external: true