services:
  ittools:
    image: corentinth/it-tools:{{ ittools_tag }}
    container_name: ittools
    restart: unless-stopped

    ports:
      - "127.0.0.1:{{ ittools_host_port }}:80"

    networks:
      - {{ traefik_docker_network }}

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.ittools.rule=Host(`ittools.{{ technitium_dns_zone }}`)"
      - "traefik.http.routers.ittools.entrypoints=websecure"
      - "traefik.http.routers.ittools.tls.certresolver=stepca"
      - "traefik.http.services.ittools.loadbalancer.server.port=80"

      - "homepage.group=Infrastructure"
      - "homepage.name=Ittools"
      - "homepage.description=Ittools"
      - "homepage.icon=it-tools.png"
      - "homepage.href=https://ittools.{{ technitium_dns_zone }}"

networks:
  {{ traefik_docker_network }}:
    external: true