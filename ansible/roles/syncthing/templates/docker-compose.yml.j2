services:
  syncthing:
    image: lscr.io/linuxserver/syncthing:{{ syncthing_tag }}
    container_name: syncthing
    restart: unless-stopped

    environment:
      - PUID={{ syncthing_user }}
      - PGID={{ syncthing_group }}
      - STGUIAPIKEY={{ syncthing_api_key }}

    ports:
      - "127.0.0.1:{{ syncthing_host_gui_port }}:8384"
      - "{{ awg_server_ip }}:{{ syncthing_host_sync_port }}:22000/tcp"
      - "{{ awg_server_ip }}:{{ syncthing_host_sync_port }}:22000/udp"

    volumes:
      - "{{ syncthing_data_dir }}:/data"
      - "{{ syncthing_config_dir }}:/config"

    networks:
      - {{ traefik_docker_network }}

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.syncthing.rule=Host(`syncthing.{{ technitium_dns_zone }}`)"
      - "traefik.http.routers.syncthing.entrypoints=websecure"
      - "traefik.http.routers.syncthing.tls.certresolver=stepca"
      - "traefik.http.services.syncthing.loadbalancer.server.port=8384"

      - "homepage.group=Infrastructure"
      - "homepage.name=syncthing"
      - "homepage.description=Syncthing"
      - "homepage.icon=syncthing.png"
      - "homepage.href=https://syncthing.{{ technitium_dns_zone }}"

networks:
  {{ traefik_docker_network }}:
    external: true