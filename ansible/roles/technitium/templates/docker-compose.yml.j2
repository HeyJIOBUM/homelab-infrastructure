services:
  technitium:
    image: docker.io/technitium/dns-server:{{ technitium_tag }}
    container_name: technitium
    restart: unless-stopped

    environment:
      - DNS_SERVER_DOMAIN=dns.{{ technitium_dns_zone }}
      - DNS_SERVER_ADMIN_PASSWORD_FILE={{ technitium_container_admin_password_file }}
      - DNS_SERVER_LOG_USING_LOCAL_TIME=true

    ports:
      - "127.0.0.1:{{ technitium_host_api_port }}:5380/tcp"
      - "{{ awg_server_ip }}:53:53/udp"
      - "{{ awg_server_ip }}:53:53/tcp"

    volumes:
      - {{ technitium_config_dir }}:/etc/dns
      - {{ technitium_admin_password_file }}:{{ technitium_container_admin_password_file }}:ro

    networks:
      {{ traefik_docker_network }}:
        ipv4_address: {{ technitium_docker_ip }}

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.technitium.rule=Host(`dns.{{ technitium_dns_zone }}`)"
      - "traefik.http.routers.technitium.entrypoints=websecure"
      - "traefik.http.routers.technitium.tls.certresolver=stepca"
      - "traefik.http.services.technitium.loadbalancer.server.port=5380"

      - "homepage.group=Infrastructure"
      - "homepage.name=Technitium"
      - "homepage.description=Technitium"
      - "homepage.icon=technitium.png"
      - "homepage.href=https://dns.{{ technitium_dns_zone }}"

networks:
  {{ traefik_docker_network }}:
    external: true