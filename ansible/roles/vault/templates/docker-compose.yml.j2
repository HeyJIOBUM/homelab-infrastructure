services:
  vault:
    image: hashicorp/vault:{{ vault_image_tag }}
    container_name: vault
    restart: unless-stopped
    
    cap_add:
      - IPC_LOCK
    
    environment:
      - VAULT_ADDR={{ vault_proto }}://127.0.0.1:{{ vault_web_port }}
      - VAULT_CLUSTER_ADDR={{ vault_proto }}://127.0.0.1:{{ vault_cluster_port }}
      - VAULT_SKIP_VERIFY=true
    
    ports:
      - "127.0.0.1:{{ vault_host_web_port }}:{{ vault_web_port }}"
      - "{{ awg_server_ip }}:{{ vault_host_web_port }}:{{ vault_web_port }}"

    volumes:
      - {{ vault_config_dir }}:/vault/config:ro
      - {{ vault_data_dir }}:/vault/data
      - {{ vault_tls_dir }}:/vault/tls:ro

    networks:
      - {{ traefik_docker_network }}

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.vault.rule=Host(`vault.{{ technitium_dns_zone }}`)"
      - "traefik.http.routers.vault.entrypoints=websecure"
      - "traefik.http.routers.vault.tls.certresolver=stepca"
      - "traefik.http.services.vault.loadbalancer.server.port={{ vault_web_port }}"
      - "traefik.http.services.vault.loadbalancer.server.scheme={{ vault_proto }}"
      - "traefik.http.services.vault.loadBalancer.serversTransport=stepca@file"

      - "homepage.group=Infrastructure"
      - "homepage.name=Vault"
      - "homepage.description=Vault"
      - "homepage.icon=vault.png"
      - "homepage.href=https://vault.{{ technitium_dns_zone }}"

    command: server

networks:
  {{ traefik_docker_network }}:
    external: true