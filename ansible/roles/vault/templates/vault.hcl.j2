storage "raft" {
  path    = "/vault/data"
  node_id = "vault-1"
}

listener "tcp" {
  address     = "0.0.0.0:{{ vault_port }}"
  tls_disable = {{ vault_tls_disable }}
{% if vault_tls_disable | bool == false %}
  tls_cert_file = "/vault/tls/vault.crt"
  tls_key_file  = "/vault/tls/vault.key"
{% endif %}
}

ui = {{ vault_ui_enabled }}

api_addr     = "{{ vault_proto }}://0.0.0.0:{{ vault_port }}"
cluster_addr = "{{ vault_proto }}://0.0.0.0:{{ vault_api_port }}"

disable_mlock = {{ vault_disable_mlock | default('true') }}