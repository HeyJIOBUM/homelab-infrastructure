# Vault AppRole credentials for {{ service_name }}
# Environment: {{ env }}
# Generated: {{ ansible_facts.date_time.iso8601 }}

# Vault connection settings
VAULT_ADDR="{{ vault_addr }}"
VAULT_ROLE_ID="{{ role_id }}"
VAULT_SECRET_ID="{{ secret_id }}"
VAULT_APPROLE_MOUNT="approle"

# Vault paths
VAULT_KV_ENGINE="{{ vault_kv_engine }}"
VAULT_SECRET_MOUNT_PATH="{{ vault_kv_engine }}/data/{{ env }}"
VAULT_SECRET_SERVICE_PATH="services/{{ service_name }}"

# Usage:
# source {{ vault_credentials_dir }}/{{ service_name }}.{{ env }}.env