services:
  wud:
    image: getwud/wud:{{ wud_tag }}
    container_name: wud
    restart: unless-stopped

    environment:
      - TZ={{ timezone }}
      - WUD_AUTH_ADMIN_USER=admin
      - WUD_AUTH_ADMIN_PASSWORD={{ wud_admin_password }}

    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ wud_data_dir }}:/store

    networks:
      - {{ traefik_docker_network }}

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.wud.rule=Host(`wud.{{ technitium_dns_zone }}`)"
      - "traefik.http.routers.wud.entrypoints=websecure"
      - "traefik.http.routers.wud.tls.certresolver=stepca"
      - "traefik.http.services.wud.loadbalancer.server.port=3000"

      - "homepage.group=Infrastructure"
      - "homepage.name=WUD"
      - "homepage.description=Docker Updates"
      - "homepage.icon=whats-up-docker.png"
      - "homepage.href=https://wud.{{ technitium_dns_zone }}"

networks:
  {{ traefik_docker_network }}:
    external: true